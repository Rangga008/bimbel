# Salin ke .env (di root, sebelah docker-compose.yml) untuk override default saat perlu.
POSTGRES_USER=bimbel
POSTGRES_PASSWORD=bimbel_secret
POSTGRES_DB=bimbel

# MinIO OPSIONAL — tidak dipakai aplikasi saat ini (media tersimpan di Postgres).
# Service-nya ada di profile "storage" (tidak start otomatis). Isi hanya bila
# mengaktifkan: docker compose --profile storage up -d
MINIO_ROOT_USER=bimbel
MINIO_ROOT_PASSWORD=bimbel_secret

# RabbitMQ — antrean job (trigger outbox WA + pencatatan poin ujian/latsol).
# Management UI: http://localhost:15672 (user/pass di bawah).
# Railway/prod tanpa broker: kosongkan RABBITMQ_URL di service api → API
# otomatis memproses job in-process seperti sebelumnya.
RABBITMQ_USER=bimbel
RABBITMQ_PASSWORD=bimbel_secret

# ====== WAJIB diganti saat deploy ke internet ======
# Secret penanda JWT — generate acak, mis: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me

# URL API yang dipakai browser pengguna (dibundel ke JS web saat build).
# Satu domain via reverse proxy : https://bimbel.example.com/api
# Beda subdomain                : https://api.bimbel.example.com/api
# Proxy same-origin (Railway)   : /api  → request dilewatkan route
#   app/api/[...path] ke API_INTERNAL_URL; cookie refresh jadi first-party
#   (selalu terkirim, tidak terblokir third-party-cookie). Wajib set
#   API_INTERNAL_URL di env runtime web bila memakai mode ini.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Origin web yang boleh akses API (koma untuk >1 origin).
CORS_ORIGIN=http://localhost:3001

# Cookie refresh token:
#  - lax    → web & API satu domain (via reverse proxy) — paling aman.
#  - none   → web & API beda origin/subdomain (WAJIB HTTPS).
#  - strict → paling ketat, hanya same-site navigation.
COOKIE_SAMESITE=lax
# auto (default) → Secure aktif otomatis bila CORS_ORIGIN https di produksi.
# Paksa: true/false.
COOKIE_SECURE=auto

# Interface bind server API. Default 0.0.0.0 = semua interface (wajib di balik
# reverse proxy/Railway); localhost tetap dilayani. Set 127.0.0.1 untuk
# dev lokal terisolasi. JANGAN pakai HOSTNAME — diisi Docker dengan container id.
HOST=0.0.0.0

# Set 1 bila API di balik reverse proxy (nginx/Cloudflare) supaya req.ip dan
# rate limit membaca X-Forwarded-For dengan benar.
TRUST_PROXY=0

# Batas waktu restore database dari Pengaturan (milidetik, default 10 menit).
# Naikkan untuk dump besar — restore berjalan atomik dan dibatalkan saat timeout.
# BACKUP_RESTORE_TIMEOUT_MS=600000

# WhatsApp gateway (Fonnte) — "log" = dummy console untuk dev.
WHATSAPP_PROVIDER=log
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=

# ====== Override port host (bila default bentrok dgn service lain) ======
# Hanya sisi HOST yang berubah — jaringan internal container tetap nama service.
# API_PORT=3000        WEB_PORT=3001
# PG_PORT=5432         REDIS_PORT=6379
# RABBITMQ_PORT=5672   RABBITMQ_UI_PORT=15672
# MINIO_PORT=9000      MINIO_UI_PORT=9001

# ====== Deploy via registry (Jalur B, docker-compose.registry.yml) ======
# Build image di lokal/CI → push → server hanya pull. Lihat docs/DEPLOYMENT.md §5.
# REGISTRY_PREFIX=ghcr.io/namaorg
# APP_VERSION=v1.0.0
